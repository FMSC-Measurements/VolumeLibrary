:: ERRFLAG","tags":"","url":"proc\\vollibfia2.html"},{"title":"vollibfia3 – Volume Library","text":"subroutine vollibfia3(REGN, IFORST, voleqi, DBHOB, HTTOT, MTOPP, MTOPS, prodi, totcu, primcu, mcu, scrbbf, intlbf, ERRFLAG) Arguments Type Intent Optional Attributes Name integer :: REGN integer :: IFORST character(len=*) :: voleqi real :: DBHOB real :: HTTOT real :: MTOPP real :: MTOPS character(len=*) :: prodi real :: totcu real :: primcu real :: mcu real :: scrbbf real :: intlbf integer :: ERRFLAG","tags":"","url":"proc\\vollibfia3.html"},{"title":"vollibfsveg – Volume Library","text":"subroutine vollibfsveg(REGN, IFORST, IDIST, voleqi, DBHOB, HTTOT, MTOPP, stems, DBTBH, STUMP, BA, SI, tcu, mcu, bdf, ERRFLAG) Arguments Type Intent Optional Attributes Name integer :: REGN integer :: IFORST integer :: IDIST character(len=*) :: voleqi real :: DBHOB real :: HTTOT real :: MTOPP integer :: stems real :: DBTBH real :: STUMP integer :: BA integer :: SI real :: tcu real :: mcu real :: bdf integer :: ERRFLAG","tags":"","url":"proc\\vollibfsveg.html"},{"title":"NUMLOG – Volume Library","text":"subroutine NUMLOG(OPT, EVOD, LMERCH, MAXLEN, MINLEN, TRIM, NUMSEG) Arguments Type Intent Optional Attributes Name integer :: OPT integer :: EVOD real :: LMERCH real :: MAXLEN real :: MINLEN real :: TRIM integer :: NUMSEG","tags":"","url":"proc\\numlog.html"},{"title":"R1KEMP – Volume Library","text":"subroutine R1KEMP(VOLEQ, HTTOT, DBHOB, VOL, LIVE, PROD, TLOGS, ERRFLAG) DETERMINE SPECIES NUMBER AND TABLE NUMBER TO BE USED * DETERMINE KLASS  * for all species\n 10 MIN EXCEPT FOR BELOW... WRITE VOLUMES TO THE VOL ARRAY  * Arguments Type Intent Optional Attributes Name character(len=10) :: VOLEQ real :: HTTOT real :: DBHOB real :: VOL (15) character(len=1) :: LIVE character(len=2) :: PROD real :: TLOGS DATA STATEMENTS           * BLOCK DATA integer :: ERRFLAG","tags":"","url":"proc\\r1kemp.html"},{"title":"R1LOGS – Volume Library","text":"subroutine R1LOGS(ISPEC, DBHOB, HTTOT, KLASS, IWHEN, TLOGS) THIS ROUTINE CALCULATES MECHANTABLE LENGTH FOR ALL TREES EXCEPT FELLED TREES Arguments Type Intent Optional Attributes Name integer :: ISPEC real :: DBHOB real :: HTTOT integer :: KLASS integer :: IWHEN real :: TLOGS","tags":"","url":"proc\\r1logs.html"},{"title":"bhre – Volume Library","text":"function bhre(L1, L2, AHAT, BHAT) result(BHRE) **BEHRE  DATE OF LAST REVISION:  01/16/91 THIS FUNCTION CALCULATES THE VOLUME OF A SOLID OF REVOLUTION\n  DESCRIBED BY A BEHRE TAPER CURVE USING PARAMETERS 'AHAT' AND 'BHAT'.\n  THE LIMITS OF INTEGRATION ARE 'L1' AND 'L2'. IT SHOULD BE NOTED THAT THE VOLUME CALCULATED IS OFF BY A FACTOR\n  OF PI/(A CUBED) - THIS VALUE WOULD CANCEL OUT IN THE RATIOS OF\n  BEHRE VOLUMES USED IN CALLING ROUTINE 'VOLS'. Arguments Type Intent Optional Attributes Name real :: L1 real :: L2 real :: AHAT real :: BHAT Return Value real","tags":"","url":"proc\\bhre.html"},{"title":"TOTVOL – Volume Library","text":"function TOTVOL(ISPC, DBHOB, HTTOT, D2H) Arguments Type Intent Optional Attributes Name integer :: ISPC real :: DBHOB real :: HTTOT real :: D2H Return Value real","tags":"","url":"proc\\totvol.html"},{"title":"R1ALLENC – Volume Library","text":"subroutine R1ALLENC(VOLEQ, DBHOB, HTTOT, TOPD, BTR, CUVOL, TCVOL, CFSTMP, ERRFLAG) Arguments Type Intent Optional Attributes Name character(len=10) :: VOLEQ real :: DBHOB real :: HTTOT real :: TOPD real :: BTR real :: CUVOL real :: TCVOL real :: CFSTMP integer :: ERRFLAG","tags":"","url":"proc\\r1allenc.html"},{"title":"R1ALLENB – Volume Library","text":"subroutine R1ALLENB(VOLEQ, DBHOB, HTTOT, TOPD, btr, BFVOL, BFSTMP, ERRFLAG) * * * * * * * * * * * **BFVOL--BS   DATE OF LAST REVISION:   07/10/95 * * BOARD FOOT MERCHANTABILITY SPECIFICATIONS * * BFVOL CALCULATES BOARD FOOT VOLUME OF ANY TREE LARGER THAN A MINIMUM \n  DBH SPECIFIED BY THE USER.  MINIMUM DBH CAN VARY BY SPECIES, \n  BUT CANNOT BE LESS THAN 2 INCHES.  DEFAULTS ARE 6 IN. FOR LODGEPOLE \n  PINE AND 7 IN. FOR ALL OTHER SPECIES.  MINIMUM MERCHANTABLE DBH IS \n  SET WITH THE BFVOLUME KEYWORD.  FOR METHB = 1, 3, OR 4, MERCHANTABLE\n  TOP DIAMETER CAN BE SET TO ANY VALUE BETWEEN 2 IN. AND MINIMUM DBH. \n  MINIMUM DBH AND TOP DIAMETER ARE ASSUMED TO BE MEASURED OUTSIDE \n  BARK--IF DIB IS DESIRED, ALLOW FOR DOUBLE BARK THICKNESS IN\n  SPECIFICATIONS. VOLUME IS BE COMPUTED BY FORMULA.  THE VOLUME FORMULA IS BASED ON \n  KEMP'S EQUATIONS, BUT ALL PARAMETERS CAN BE REPLACED BY THE USER WITH \n  THE BFVOLEQ KEYWORD.  KEMP'S EQUATIONS IMPLY SPECIFIC MERCHANTABILITY \n  STANDARDS (9\" MINIMUM DBH, 8\" MINIMUM TOP DIAMETER, AND 1' STUMP). WHEN METHB=1, EQUATIONS DEVELOPED BY  ALLEN, ADAMS, AND PRAUSA (1974: \n  IDAHO FORESTRY, WILDLIFE, AND RANGE EXPERIMENT STATION NOTE # 21) \n  ARE APPLIED TO COMPUTE VOLUMES FOR THE PORTION OF THE TREE BETWEEN \n  AN 8\" TOP DIAMETER AND THE USER SPECIFIED MERCHANTABILITY LIMIT. THE\n  VALUE OF D2H FOR WHICH ALLEN'S AND KEMP'S EQUATIONS ARE EQUAL IS \n  CALLED D2HBRK, AND VARIES BY SPECIES.  FOR TREES WITH DBH < D2HBRK,\n  ALLEN'S EQUATIONS ARE USED; FOR LARGER TREES, KEMP'S EQUATIONS ARE\n  USED.  THE TRANSITION IS SMOOTH AND TREES DO NOT LOSE VOLUME AS THEY\n  INCREASE IN SIZE.  FOR METHB=2, ONLY THE KEMP EQUATIONS ARE USED,\n  AND VOLUME ABOVE THE 8\" TOP IS IGNORED. ASSUMED SPECIES CORRESPONDENCE IS AS FOLLOWS: ACTUAL SPECIES     ALLEN'S EQUATIONS\n          -------------------  ----------------------\n     1     WESTERN WHITE PINE   LODGEPOLE PINE\n     2     WESTERN LARCH        WESTERN LARCH\n     3     DOUGLAS-FIR          DOUGLAS-FIR\n     4     GRAND FIR            GRAND FIR\n     5     WESTERN HEMLOCK      GRAND FIR\n     6     WESTERN REDCEDAR     WESTERN LARCH\n     7     LODGEPOLE PINE       LODGEPOLE PINE\n     8     ENGELMANN SPRUCE     GRAND FIR\n     9     SUBALPINE FIR        GRAND FIR\n    10     PONDEROSA PINE       DOUGLAS-FIR\n    11     MOUNTAIN HEMLOCK     GRAND FIR VOLUME LOSS DUE TO TOP DAMAGE (TKILL=.TRUE.) IS ESTIMATED WITH A \n  BEHRE HYPERBOLA TAPER MODEL, WITH PARAMETERS ESTIMATED FROM TOTAL \n  CUBIC FOOT VOLUME, HEIGHT AND DIAMETER. COFBVS -- COEFFICIENT IN BOARD FOOT VOLUME EQUATION FOR TREES\n            HAVING D2H LESS THAN D2HBRK(ISPC)\n  D2HBRK -- THE VALUE OF D2H BELOW WHICH ALLEN'S EQUATIONS\n            ARE USED TO COMPUTE BOARD FOOT VOLUME.\n  HDRATM -- ESTIMATED HEIGHT/DIAMETER RATIO THAT IS INDEXED BY\n            EITHER DBH OR TOP DIAMETER.\n  HDRATA -- ACTUAL HEIGHT/DIAMETER RATIO FOR THE SUBJECT TREE. Arguments Type Intent Optional Attributes Name character(len=10) :: VOLEQ real :: DBHOB real :: HTTOT real :: TOPD real :: btr real :: BFVOL real :: BFSTMP integer :: ERRFLAG","tags":"","url":"proc\\r1allenb.html"},{"title":"R9_MHTS – Volume Library","text":"subroutine R9_MHTS(IFORST, VOLEQ, DBH, HTTOT, SI, BA, HT1PRD, HT2PRD, PROD, ERRFLAG, MTOPP) CALCULATES THE MERCH HTS BASED ON TOTAL TREE HEIGHT BY FORST AND SPECIES\n YW 07/13/2018 Added variable MTOPP to the subroutine and use the variable to replace hardcoded 9.6 Arguments Type Intent Optional Attributes Name integer :: IFORST character(len=10) :: VOLEQ real :: DBH real :: HTTOT integer :: SI integer :: BA real :: HT1PRD real :: HT2PRD character(len=2) :: PROD integer :: ERRFLAG real :: MTOPP","tags":"","url":"proc\\r9_mhts.html"},{"title":"R9INIT – Volume Library","text":"subroutine R9INIT(VOLEQ, B, VFLAG, ERRFLAG) DECLARE VARIBLES         * Arguments Type Intent Optional Attributes Name character(len=10) :: VOLEQ real :: B (6) integer :: VFLAG integer :: ERRFLAG","tags":"","url":"proc\\r9init.html"},{"title":"DVEST – Volume Library","text":"subroutine DVEST(VOLEQ, DBHOB, DRC, HTTOT, MTOPP, FCLASS, HTLOG, HT1PRD, HT2PRD, FORST, BTR, VOL, CUTFLG, BFPFLG, CUPFLG, CDPFLG, SPFLG, PROD, HTTYPE, HTTFLL, NOLOGP, LIVE, BA, SI, CTYPE, ERRFLAG, MTOPS, STUMP) REGION 1 D2H ROUTINES * REGION 2 D2H ROUTINES * REGION 3 D2H ROUTINES * --------- SAWTIMBER TREES REGION 4 D2H ROUTINES * REGION 5 D2H ROUTINES * REGION 9 D2H ROUTINES * REGION 10 D2H ROUTINES * ARMY BASE D2H ROUTINES * Canadian Honor Equation used by BIA in eastern region * Arguments Type Intent Optional Attributes Name character(len=10) :: VOLEQ real :: DBHOB real :: DRC real :: HTTOT real :: MTOPP integer :: FCLASS integer :: HTLOG real :: HT1PRD real :: HT2PRD character(len=2) :: FORST real :: BTR real :: VOL (15) integer :: CUTFLG integer :: BFPFLG integer :: CUPFLG integer :: CDPFLG integer :: SPFLG character(len=2) :: PROD character(len=1) :: HTTYPE integer :: HTTFLL real :: NOLOGP character(len=1) :: LIVE integer :: BA integer :: SI character(len=1) :: CTYPE integer :: ERRFLAG real :: MTOPS real :: STUMP","tags":"","url":"proc\\dvest.html"},{"title":"MRULES_MOD – Volume Library","text":"Derived Types type, public, sequence  :: MERCHRULES Components Type Visibility Attributes Name Initial integer, public :: EVOD integer, public :: OPT real, public :: MAXLEN real, public :: MINLEN real, public :: MINLENT real, public :: MERCHL real, public :: MTOPP real, public :: MTOPS real, public :: STUMP real, public :: TRIM real, public :: BTR real, public :: DBTBH real, public :: MINBFD character(len=1), public :: COR","tags":"","url":"module\\mrules_mod.html"},{"title":"VOLINPUT_MOD – Volume Library","text":"Variables Type Visibility Attributes Name Initial integer, public :: FORMCLASS character(len=1), public :: MRULEMOD/\"0\"/ integer, public :: NEWEVOD integer, public :: NEWOPT real, public :: NEWMAXLEN real, public :: NEWMINLEN real, public :: NEWMINLENT real, public :: NEWMERCHL real, public :: NEWMTOPP real, public :: NEWMTOPS real, public :: NEWSTUMP real, public :: NEWTRIM real, public :: NEWBTR real, public :: NEWDBTBH real, public :: NEWMINBFD character(len=1), public :: NEWCOR/\"0\"/","tags":"","url":"module\\volinput_mod.html"},{"title":"R8DIB – Volume Library","text":"Variables Type Visibility Attributes Name Initial real, public :: R8CF (182,18)","tags":"","url":"module\\r8dib.html"},{"title":"CLKCOEF_MOD – Volume Library","text":"Derived Types type, public, sequence  :: CLKCOEF Components Type Visibility Attributes Name Initial real, public :: DBHIB real, public :: DIB17 real, public :: R real, public :: C real, public :: E real, public :: P real, public :: B real, public :: A real, public :: A4 real, public :: B4 real, public :: A17 real, public :: B17 real, public :: TOTHT real, public :: Q real, public :: FIXDI real, public :: DX real, public :: AFI real, public :: BFI integer, public :: SPGRP","tags":"","url":"module\\clkcoef_mod.html"},{"title":"CHARMOD – Volume Library","text":"Derived Types type, public, sequence  :: CHAR256 Components Type Visibility Attributes Name Initial integer, public :: LENGTH character(len=256), public :: STR","tags":"","url":"module\\charmod.html"},{"title":"R8VLIST – Volume Library","text":"Variables Type Visibility Attributes Name Initial character(len=19), public :: ATMP1 (2592)","tags":"","url":"module\\r8vlist.html"},{"title":"DEBUG_MOD – Volume Library","text":"Variables Type Visibility Attributes Name Initial logical, public :: ANY_DEBUG/.FALSE./ integer, public :: LUDBG/1/ integer, public :: VEDBG/3/ integer, public :: LUOUT/2/ type( DEBUG_INDICATORS ), public :: DEBUG Derived Types type, public :: DEBUG_INDICATORS Components Type Visibility Attributes Name Initial logical, public :: INPUT logical, public :: DLL logical, public :: MODEL logical, public :: ANALYSIS logical, public :: EXTERNAL logical, public :: VOLEQ","tags":"","url":"module\\debug_mod.html"},{"title":"bia_behres.f – Volume Library","text":"Source Code SUBROUTINE BIA_Behres_Hyperobla ( dbh , ht , FCLASS , & MinBDFTTop , VOL ) C     The source code is from BIA with little modification to work with NVEL C     2019/04/04 YW Assigned equation number I16BEHW000 for the equation C     It only work for 16 feet log. IMPLICIT NONE REAL dbh , ht , formclass , LogLength , MinBDFTTop , & CalcBDFTVolume REAL MerchHt , VOL ( 15 ) INTEGER ISEG , numsegs , FCLASS , ILOGLEN REAL BD1 , BD2 , DIB16 , FC16 REAL D , DIB , BD79 , RHT , BHT , SEG , XL , CDIB REAL tht DOUBLE PRECISION BD80 C     --- SPECIFICATION STATEMENTS IF ( FCLASS . LT . 10 ) THEN formclass = 0.0 ELSE formclass = REAL ( FCLASS ) / 10 0.0 ENDIF LogLength = 1 6.0 tht = ht FC16 = formclass C     Note: there used to be a long set of code to calculate C     Form Class.  This needs to be calculated BEFORE coming C     to this subroutine CalcBDFTVolume = 0.0 MerchHt = 0.0 DIB16 = 0.0 FC16 = 0.0 IF ( formclass . EQ . 0.0 ) formclass = 0.7 DIB16 = dbh * formclass IF ( DIB16 . GT . dbh ) DIB16 = dbh CalcBDFTVolume = 0.0 SEG = 0.0 DIB = DIB16 BD79 = 0.0 BD80 = 0.0 RHT = 0.0 IF ( DIB . LT . MinBDFTTop ) THEN RETURN ENDIF C     --- CALCULATE VOLUME OF BUTT LOG IF ( DIB . LT . 8.0 ) THEN BD79 = REAL (( - 0.083714 + 0.018569 * DIB + 0.059009 & * ( DIB ** 2 ) - 0.003894 * ( DIB ** 3 )) * LogLength ) CalcBDFTVolume = REAL ( BD79 ) ELSE BD80 = ( - 0.26875 - 0.12375 * DIB + 0.049375 * & ( DIB ** 2 )) * LogLength CalcBDFTVolume = REAL ( BD80 ) ENDIF MerchHt = 1 7.3 C     --- CALCULATE BHT (HEIGHT FROM TOP OF 1ST LOG TO TOP) BHT = REAL ( tht - 1 7.3 ) SEG = 0 numsegs = NINT ( BHT / 1 6.3 ) DO 10 ISEG = 1 , numsegs SEG = REAL ( SEG + 1 6.3 ) BD80 = 0 BD79 = 0 RHT = BHT - SEG IF ( RHT . GT . 0.0 ) THEN XL = RHT / BHT D = REAL ( XL / ( 0.49 * XL + 0.51 )) C             ' --- CALCULATE DIB OF CURRENT LOG CDIB = DIB * D If ( CDIB . GE . MinBDFTTop ) THEN If ( CDIB . LE . 8 ) THEN BD79 = REAL (( - 0.083714 + 0.018569 * CDIB & + 0.059009 * ( CDIB ** 2 ) - 0.003894 & * ( CDIB ** 3 )) * LogLength ) CalcBDFTVolume = CalcBDFTVolume + BD79 BD1 = BD79 ELSE BD80 = ( - 0.26875 - 0.12375 * CDIB + & 0.049375 * ( CDIB ** 2 )) * LogLength CalcBDFTVolume = REAL ( CalcBDFTVolume & + BD80 ) BD2 = REAL ( BD80 ) ENDIF MerchHt = REAL ( MerchHt + ( ISEG * 1 6.3 )) ELSE C                  Segment top diameter less than minimum C                  add length back on to the log and exit loop C                                 Print #6, \"FULLSEG \"; Iseg; C                                 Print #6, Space(15) & CDIB & C                                 Print #6, \"Segment Skipped\" RHT = REAL ( RHT + 1 6.3 ) EXIT ENDIF ENDIF 10 CONTINUE C     --- CYCLE UP LAST SEGMENT IN 1' JUMPS SEG = 1.01875 LogLength = 0 BD79 = 0 BD80 = 0 numsegs = NINT ( RHT / SEG ) DO 20 ISEG = 1 , numsegs RHT = RHT - SEG LogLength = LogLength + 1.0 XL = RHT / BHT D = REAL ( XL / ( 0.49 * XL + 0.51 )) CDIB = DIB * D IF ( CDIB . LT . MinBDFTTop ) THEN IF ( CDIB . LT . 8.0 ) THEN BD79 = REAL (( - 0.083714 + 0.018569 * CDIB & + 0.059009 * ( CDIB ** 2 ) - 0.003894 & * ( CDIB ** 3 )) * LogLength ) CalcBDFTVolume = CalcBDFTVolume + BD79 ELSEIF ( CDIB . GE . 8.0 ) THEN BD80 = ( - 0.26875 - 0.12375 * CDIB + 0.049375 & * ( CDIB ** 2 )) * LogLength CalcBDFTVolume = REAL ( CalcBDFTVolume + BD80 ) ENDIF MerchHt = MerchHt + ( ISEG * SEG ) EXIT ENDIF 20 CONTINUE VOL ( 2 ) = CalcBDFTVolume END","tags":"","url":"sourcefile\\bia_behres.f.html"},{"title":"formclas.f – Volume Library","text":"Source Code c  last modified  02-10-2012 C     SUBROUTINES to determine the default Form Class. c      contains the following subroutines c           FORMCL_BM c           FORMCL_CA c           FORMCL_EC c           FORMCL_NI c           FORMCL_PN c           FORMCL_SO c           FORMCL_WA SUBROUTINE FORMCL_BM ( SPEC , IFOR , D , FC ) C---------- C  **FORMCL--BM     DATE OF LAST REVISION:  08/13/96 C---------- CHARACTER * 3 FIAJSP ( 11 ), SPEC REAL D INTEGER MALHFC ( 11 , 5 ), OCHOFC ( 11 , 5 ), UMATFC ( 11 , 5 ) INTEGER WLWHFC ( 11 , 5 ), FC , IFCDBH , ISPC , IFOR INTEGER DONEFLAG , LASTFLAG , FIRST , LAST , HALF C---------- C  FOREST ORDER: (IFOR) C  4=MALHEUR(604)          7=OCHOCO(607)        14=UMATILLA(614) C 16=WALLOWA-WHITMAN(616) C C  SPECIES ORDER: (ISPC) C  1=WP  2=WL  3=DF  4=GF  5=MH  6=    7=LP  8=ES  9=AF 10=PP 11=J/OT DATA FIAJSP / '   ' , '017' , '019' , '073' , '093' , '108' , '119' , '122' , & '202' , '264' , '999' / C---------- C  MALHEUR FORM CLASS VALUES 