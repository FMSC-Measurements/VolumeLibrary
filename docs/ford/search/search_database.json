real :: q integer :: errflg","tags":"","url":"proc\\r8cubic.html"},{"title":"R8DIB – Volume Library","text":"subroutine R8DIB(dib, dbhib, dib17, topht, highht, r, c, e, p, b, a, q, errflg) Calculates inside-bark diameter (dib) at any specified height (highht)\n  given inside-bark dbh (dbhib), inside-bark diameter at 17.3' (dib17) \n  and total height (topht) for the specified \n  species (spp).   r, c, e, p, b, a, and q \n  are the coefficients for inside-bark diameter calculation. Arguments Type Intent Optional Attributes Name real :: dib real :: dbhib real :: dib17 real :: topht real :: highht real :: r real :: c real :: e real :: p real :: b real :: a real :: q integer :: errflg","tags":"","url":"proc\\r8dib.html"},{"title":"R8CLARK – Volume Library","text":"subroutine R8CLARK(VOLEQ, FORST, STUMP, MTOPP, MTOPS, DBHOB, HT1PRD, HT2PRD, HTTOT, LOGDIA, BOLHT, LOGLEN, LOGVOL, VOL, CUTFLG, BFPFLG, CUPFLG, CDPFLG, SPFLG, PROD, ERRFLG, CTYPE, UPSHT1, TLOGS, NOLOGP, NOLOGS) Uses VOLINPUT_MOD CLKCOEF_MOD Arguments Type Intent Optional Attributes Name character(len=1) :: VOLEQ *10 character(len=1) :: FORST *2 real :: STUMP real :: MTOPP real :: MTOPS real :: DBHOB real :: HT1PRD real :: HT2PRD real :: HTTOT real :: LOGDIA (21,3) real :: BOLHT (21) real :: LOGLEN (20) real :: LOGVOL (7,20) real :: VOL (15) integer :: CUTFLG integer :: BFPFLG integer :: CUPFLG integer :: CDPFLG integer :: SPFLG character(len=1) :: PROD *2 integer :: ERRFLG character(len=1) :: CTYPE real :: UPSHT1 integer :: TLOGS real :: NOLOGP real :: NOLOGS","tags":"","url":"proc\\r8clark.html"},{"title":"R8LOGDIB – Volume Library","text":"subroutine R8LOGDIB(VOLEQ, FORST, DBHOB, HTTOT, UPSHT1, NUMSEG, TRIM, STUMP, BOLHT, LOGLEN, LOGDIA, ERRFLAG) Uses CLKCOEF_MOD Arguments Type Intent Optional Attributes Name character(len=10) :: VOLEQ character(len=2) :: FORST real :: DBHOB real :: HTTOT real :: UPSHT1 integer :: NUMSEG real :: TRIM real :: STUMP real :: BOLHT (21) real :: LOGLEN (20) real :: LOGDIA (21,3)