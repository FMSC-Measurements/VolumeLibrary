ter(len=*) :: CTYPE integer :: ERRFLAG integer :: IDIST type(MERCHRULES) :: MERRULES","tags":"","url":"proc\\vollibvb~2.html"},{"title":"str2int – Volume Library","text":"subroutine str2int(str, int, stat) Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: str integer, intent(out) :: int integer, intent(out) :: stat","tags":"","url":"proc\\str2int~2.html"},{"title":"R10VOL1 – Volume Library","text":"subroutine R10VOL1(EQNUM, MTOPP, MTOPS, HTTOT, HT1PRD, DBHOB, HTTYPE, VOL, NOLOGP, NOLOGS, TLOGS, LOGLEN, LOGDIA, LOGVOL, BFPFLG, CUPFLG, SPFLG, ERRFLAG) LOCAL VARIABLES                                   * BOARD FOOT CACULATIONS  (DBHOB GE 9.0)              * GET SCRIBNER VOLUME FOR THE PIECES                   * IF 32FT EQ THEN NEED TO BREAK LOGS INTO 16FT PIECES  * PRO-RATE LOG VOLUMES TO PRODUCE PIECE VOLUMES * GET CUBIC VOLUME FOR THE PIECES SMALIAN FORMULA     * --    DETERMINE TOTAL CUBIC FIBER CONTENT (ALL TREES)       * CORD WOOD MAIN STEM EQUATIONS  ALL TREES             * --   SET TLOGS TO NUMBER OF SEGMENTS MAIN STEM IF 32FT LOGS THEN FILL LOG ARRARYS WITH THE PIECE INFO   * --  DETERMINE TOP WOOD CUBIC FOOT PRODUCTS (ALL TREES) Arguments Type Intent Optional Attributes Name character(len=10) :: EQNUM real :: MTOPP real :: MTOPS real :: HTTOT real :: HT1PRD real :: DBHOB character(len=1) :: HTTYPE real :: VOL (15) real :: NOLOGP real :: NOLOGS integer :: TLOGS real :: LOGLEN (20) real :: LOGDIA (21,3) real :: LOGVOL (7,20) integer :: BFPFLG integer :: CUPFLG integer :: SPFLG integer :: ERRFLAG","tags":"","url":"proc\\r10vol1.html"},{"title":"R10MLEN – Volume Library","text":"subroutine R10MLEN(EQNUM, HTTOT, DBHOB, STUMP, TOP, LMERCH) --   SUBROUTINE WILL DETERMINE WHAT THE MERCHANTABLE LENGTH OF\n--   STEM FROM THE STUMP TO A SPECIFIED TOP, INCLUDING TRIM.\n--   NO ROUNDING IS USED WHEN FINDING THE MINIMUM TOP DIAMETER.\n--   IF THE SPECIFIED MINIMUM TOP IS SET TO 6\" THEN 6\" DIB\n--   WITHOUT ROUNDING IS USED AS THE CUT-OFF POINT.\n--   USED ONLY FOR TOPWOOD VOLUME DETERMINATION Arguments Type Intent Optional Attributes Name character(len=10) :: EQNUM real :: HTTOT real :: DBHOB real :: STUMP real :: TOP real :: LMERCH","tags":"","url":"proc\\r10mlen.html"},{"title":"R10GDIB – Volume Library","text":"subroutine R10GDIB(EQNUM, TOP, HTTOT, DBHOB, STUMP, TRIM, TLOGS, NUMSEG, LOGLEN, LOGDIA) --   ALL LOG DIAMETERS ARE ROUNDED TO THE NEAREST 1 INCH\n--   CLASS (I.E. 8\" CLASS = 7.6 - 8.5) Arguments Type Intent Optional Attributes Name character(len=10) :: EQNUM real :: TOP real :: HTTOT real :: DBHOB real :: STUMP real :: TRIM integer :: TLOGS integer :: NUMSEG real :: LOGLEN (20) real :: LOGDIA (21,3)","tags":"","url":"proc\\r10gdib.html"},{"title":"R10_HTS – Volume Library","text":"subroutine R10_HTS(EQNUM, HTTOT, HT1PRD, DBHOB, HTTYPE, STUMP, TOP, LMERCH) TAPEQU IS THE PROFILE EQUATION NUMBER THAT WILL BE USED IN THE \n         CALCULATIONS\n         TAPEQU 1051 IS SPRUCE-HEMLOCK - 16 FOOT LOGS\n         TAPEQU 1052 IS SPRUCE-HEMLOCK - 32 FOOT LOGS\n         TAPEQU 1053 IS WESTERN REDCEDAR - 16 FOOT LOGS\n         TAPEQU 1054 IS WESTERN REDCEDAR - 32 FOOT LOGS\n         TAPEQU 1055 IS ALASKA CEDAR - 16 FOOT LOGS\n         TAPEQU 1056 IS ALASKA CEDAR - 32 FOOT LOGS\n HTTOT    IS THE TOTAL HEIGHT OF TREE FROM GROUND TO TIP\n DBHOB    IS DIAMETER BREAST HEIGHT OUTSIDE BARK\n STUMP  IS THE HEIGHT OF THE STUMP\n TOP    IS SPECIFIED TOP DIAMETER\n LMERCH IS THE MERCHANTABLE LENTH FROM STUMP TO SPECIFIED\n         TOP DIAMETER, INCLUDING TRIM. BARK THICKNESS EQUATION BARK THICKNESS EQUATION FOR WESTERN RED CEDAR BARK THICKNESS EQUATION FOR ALASKA YELLOW CEDAR BARK THICKNESS EQUATION FOR RED ALDER Arguments Type Intent Optional Attributes Name character(len=10) :: EQNUM real :: HTTOT real :: HT1PRD real :: DBHOB character(len=1) :: HTTYPE real :: STUMP real :: TOP real :: LMERCH","tags":"","url":"proc\\r10_hts.html"},{"title":"R10TC – Volume Library","text":"subroutine R10TC(VOLEQ, DBHOB, HTTOT, TCVOL) Arguments Type Intent Optional Attributes Name character(len=10) :: VOLEQ real :: DBHOB real :: HTTOT real :: TCVOL","tags":"","url":"proc\\r10tc.html"},{"title":"I1MACH – Volume Library","text":"function I1MACH(I) Arguments Type Intent Optional Attributes Name integer :: I Return Value integer","tags":"","url":"proc\\i1mach.html"},{"title":"R1MACH – Volume Library","text":"function R1MACH(I) Arguments Type Intent Optional Attributes Name integer :: I Return Value real","tags":"","url":"proc\\r1mach.html"},{"title":"D1MACH – Volume Library","text":"function D1MACH(I) Arguments Type Intent Optional Attributes Name integer :: I Return Value doubleprecision","tags":"","url":"proc\\d1mach.html"},{"title":"AMSUB1 – Volume Library","text":"function AMSUB1(TEST1) Arguments Type Intent Optional Attributes Name double precision :: TEST1 Return Value doubleprecision","tags":"","url":"proc\\amsub1.html"},{"title":"SF_ZERO – Volume Library","text":"subroutine SF_ZERO(X1, F1, X2, F2, MODE, TOL) Arguments Type Intent Optional Attributes Name real :: X1 **  In the statement below, $ is replaced by an 'S' for single\n**  precision and a 'D' for double.\n XXX call $ZERO(X1,F1,X2,F2,MODE,TOL)\n     go to  (N1,N2,N3,N4,N5,N6), MODE\n  N1 COMPUTE  F1=F(X1)\n     go to XXX N4 continue\n  N5 continue\n  N6 stop\n  N3 If you want to -- print results to note that error\n                       is too big.\n  N2 zero is found, do whatever you want to with it. End of comments explaining usage. * * * * Usage of internal variables * * * C0     Parameter = 0.\n C1     Parameter = 1.\n C1P01  Parameter = 1.01\n C1P25  Parameter = 1.25\n C2     Parameter = 2.\n C4     Parameter = 4.\n CP01   Parameter = 0.01\n CP125  Parameter = 1.25\n CP25   Parameter = 0.25\n CP5    Parameter = 0.5\n CP75   Parameter = 0.75\n CP99   Parameter = 0.99\n R1MACH Gets constants associated with floating point arithmetic.\n DFDXXX = (XXMXL/FFMFL) * (est. deriv. of f w.r.t. x at x = XX).  All\n   derivatives are base on a second degree polynonial that interpolates\n   the last three points generated.\n DFDXXX = (XXMXO/FFMFL) * (est. deriv. of f w.r.t. x at x = X0).\n DIV    If artificial subdivision of the interval is used, determines\n   the amount of the sudivision.  (-XXMXOO * DIV / (1. + DIV))\n SMESS  Prints error messages.\n DXDFFF = (FFMFL/XXMXL) * (est. deriv. of x w.r.t. f at f = FF).\n DXDFFO = (FFMFO/XXMXL) * (est. deriv. of x w.r.t. f at f = FO).\n F1     (formal arg.) The last value of F computed, on return the value\n   of F(X1).\n F2     (formal arg.) The other initial value provided for F.  Set to\n   the value of F(X2) on returns.\n FDAT   Temporary storage for floating point values for messages.\n FF     Value of F1 after F is computed.\n FFDFO  FF / FO\n FFMFB  FFMFL + FLMFB = FF - value of FF 2 iterations back.\n FFMFL  FF - FL\n FL     Value of FF from the previous iteration. FLMFB  Value of FFMFL from the previous iteration\n FO     F(XO)\n I      Comments for LCHNG define how I is set.\n IDAT   Temporary storage for integer values for messages.\n INDIC  Internal value to be assigned to MODE on exit.  Equivalenced to\n   MACT(3) and set to 0 initially.\n J      This is 1 if FF .le. 0., and is 2 if FF > 0.\n KNKP   KNKP(J) (see J above) is set to 0 whenever there are signs of\n   decent convergence.  It is counted up when convergence is slow.\n KS     =-1  initially,\n        = 0  whenever F changes sign, otherwise\n        = number of times the sign of F has remained the same\n KTYP   = 1 if interpolation was used to get the last iterate, = 0 if\n   an artificial subdivision was used.\n LCHG  the J-th continuation in the data statement for LCHG below gives\n new states for the case when the state number is J-1.  State 0 is the\n initial state.  The I-th entry on a row gives the state for case on I\n as follows:  (TP is the ratio (new f) / (last f of same sign)\n    I = 1   TP < 0.01\n    I = 2   .01 <= TP < 1\n    I = 3   TP = 1\n    I = 4   1 < TP <= 4\n    I = 5   TP > 4.\n States are as follows:\n    0   initial state, or big increase, or small increase in state 0\n    1   after big decrease, perhaps followed by small decreases\n    2   after one or more small decreases from state 0\n    3   one or more small increases from state 2\n    4   one or more small decreases from state 3\n    5   decision made that noise is a problem on this side of zero.\n LINIT  - the maximum number of iterations that can be taken with out\n   getting a sign change in F.\n LMODE  The value of MODE the last time in this routine.\n LNLP LTXTxx Names of this form are used in setting up data statements for\n   error messages.  These names are generated automatically by PMESS,\n   the program that makes up these messages.\n MACT   This array difines the actions to be taken by the error message\n   program.  See comments in MESS for details.\n MACT1  As for MACT except used for the diagnostic print.\n MExxxx Parameters defining constants used for interaction with the\n   error message program MESS.  See comments there for definitions.\n MLOC   Contains locations in MTXTAA for error messages.\n MODE   (formal) See comments above.\n MTXTAA Text for error messages.\n MTXTAB Text for diagnostic message.\n MTXTAC Text for diagnostic message.\n NP     If > 0, gives number of iterations till diagnostic print stops.\n QFM QXM RND    Largest relative difference between succesive floating point\n   numbers.\n SMALL  .5 / (RND * largest floating point number)\n TOL    (Formal) See description above.\n TOLX   Actually tolerance required for accuracy in X.  Usually =\n   max(TOL, XRND).  It can be cut by a factor of 2 for use in setting\n   bounds on an acceptable interval.\n TP     Ordinarily the ratio (FF / prev. FF of the same sign.\n TP1    Used for temporary storage.\n X1     (Formal) Value of x where F is to be computed, and value\n   returned for the zero after convergence.\n X2     (Formal) Initially other value of x where F is given.  After\n   convergence gives the other closest x which gives an F of opposite\n   sign from that given by x1.\n XL     Value of XX from the previous iteration.\n XLMXB  Value of XXMXL from the previous iteration.\n XO     Value of x on opposite side of the zero from the current x.\n XRND   Best accuracy that one could hope for based on the finite\n   precision of floating point numbers.\n XX     Current x, the last value of X1 where F was computed.\n XXMXL  XX - XL\n XXMXO  XX - XO = length of interval in which 0 lies.\n XXMXOL Value of XXMXO from a previous iteration. real :: F1 **  In the statement below, $ is replaced by an 'S' for single\n**  precision and a 'D' for double.\n XXX call $ZERO(X1,F1,X2,F2,MODE,TOL)\n     go to  (N1,N2,N3,N4,N5,N6), MODE\n  N1 COMPUTE  F1=F(X1)\n     go to XXX N4 continue\n  N5 continue\n  N6 stop\n  N3 If you want to -- print results to note that error\n                       is too big.\n  N2 zero is found, do whatever you want to with it. End of comments explaining usage. * * * * Usage of internal variables * * * C0     Parameter = 0.\n C1     Parameter = 1.\n C1P01  Parameter = 1.01\n C1P25  Parameter = 1.25\n C2     Parameter = 2.\n C4     Parameter = 4.\n CP01   Parameter = 0.01\n CP125  Parameter = 1.25\n CP25   Parameter = 0.25\n CP5    Parameter = 0.5\n CP75   Parameter = 0.75\n CP99   Parameter = 0.99\n R1MACH Gets constants associated with floating point arithmetic.\n DFDXXX = (XXMXL/FFMFL) * (est. deriv. of f w.r.t. x at x = XX).  All\n   derivatives are base on a second degree polynonial that interpolates\n   the last three points generated.\n DFDXXX = (XXMXO/FFMFL) * (est. deriv. of f w.r.t. x at x = X0).\n DIV    If artificial subdivision of the interval is used, determines\n   the amount of the sudivision.  (-XXMXOO * DIV / (1. + DIV))\n SMESS  Prints error messages.\n DXDFFF = (FFMFL/XXMXL) * (est. deriv. of x w.r.t. f at f = FF).\n DXDFFO = (FFMFO/XXMXL) * (est. deriv. of x w.r.t. f at f = FO).\n F1     (formal arg.) The last value of F computed, on return the value\n   of F(X1).\n F2     (formal arg.) The other initial value provided for F.  Set to\n   the value of F(X2) on returns.\n FDAT   Temporary storage for floating point values for messages.\n FF     Value of F1 after F is computed.\n FFDFO  FF / FO\n FFMFB  FFMFL + FLMFB = FF - value of FF 2 iterations back.\n FFMFL  FF - FL\n FL     Value of FF from the previous iteration. FLMFB  Value of FFMFL from the previous iteration\n FO     F(XO)\n I      Comments for LCHNG define how I is set.\n IDAT   Temporary storage for integer values for messages.\n INDIC  Internal value to be assigned to MODE on exit.  Equivalenced to\n   MACT(3) and set to 0 initially.\n J      This is 1 if FF .le. 0., and is 2 if FF > 0.\n KNKP   KNKP(J) (see J above) is set to 0 whenever there are signs of\n   decent convergence.  It is counted up when convergence is slow.\n KS     =-1  initially,\n        = 0  whenever F changes sign, otherwise\n        = number of times the sign of F has remained the same\n KTYP   = 1 if interpolation was used to get the last iterate, = 0 if\n   an artificial subdivision was used.\n LCHG  the J-th continuation in the data statement for LCHG below gives\n new states for the case when the state number is J-1.  State 0 is the\n initial state.  The I-th entry on a row gives the state for case on I\n as follows:  (TP is the ratio (new f) / (last f of same sign)\n    I = 1   TP < 0.01\n    I = 2   .01 <= TP < 1\n    I = 3   TP = 1\n    I = 4   1 < TP <= 4\n    I = 5   TP > 4.\n States are as follows:\n    0   initial state, or big increase, or small increase in state 0\n    1   after big decrease, perhaps followed by small decreases\n    2   after one or more small decreases from state 0\n    3   one or more small increases from state 2\n    4   one or more small decreases from state 3\n    5   decision made that noise is a problem on this side of zero.\n LINIT  - the maximum number of iterations that can be taken with out\n   getting a sign change in F.\n LMODE  The value of MODE the last time in this routine.\n LNLP LTXTxx Names of this form are used in setting up data statements for\n   error messages.  These names are generated automatically by PMESS,\n   the program that makes up these messages.\n MACT   This array difines the actions to be taken by the error message\n   program.  See comments in MESS for details.\n MACT1  As for MACT except used for the diagnostic print.\n MExxxx Parameters defining constants used for interaction with the\n   error message program MESS.  See comments there for definitions.\n MLOC   Contains locations in MTXTAA for error messages.\n MODE   (formal) See comments above.\n MTXTAA Text for error messages.\n MTXTAB Text for diagnostic message.\n MTXTAC Text for diagnostic message.\n NP     If > 0, gives number of iterations till diagnostic print stops.\n QFM QXM RND    Largest relative difference between succesive floating point\n   numbers.\n SMALL  .5 / (RND * largest floating point number)\n TOL    (Formal) See description above.\n TOLX   Actually tolerance required for accuracy in X.  Usually =\n   max(TOL, XRND).  It can be cut by a factor of 2 for use in setting\n   bounds on an acceptable interval.\n TP     Ordinarily the ratio (FF / prev. FF of the same sign.\n TP1    Used for temporary storage.\n X1     (Formal) Value of x where F is to be computed, and value\n   returned for the zero after convergence.\n X2     (Formal) Initially other value of x where F is given.  After\n   convergence gives the other closest x which gives an F of opposite\n   sign from that given by x1.\n XL     Value of XX from the previous iteration.\n XLMXB  Value of XXMXL from the previous iteration.\n XO     Value of x on opposite side of the zero from the current x.\n XRND   Best accuracy that one could hope for based on the finite\n   precision of floating point numbers.\n XX     Current x, the last value of X1 where F was computed.\n XXMXL  XX - XL\n XXMXO  XX - XO = length of interval in which 0 lies.\n XXMXOL Value of XXMXO from a previous iteration. real :: X2 **  In the statement below, $ is replaced by an 'S' for single\n**  precision and a 'D' for double.\n XXX call $ZERO(X1,F1,X2,F2,MODE,TOL)\n     go to  (N1,N2,N3,N4,N5,N6), MODE\n  N1 COMPUTE  F1=F(X1)\n     go to XXX N4 continue\n  N5 continue\n  N6 stop\n  N3 If you want to -- print results to note that error\n                       is too big.\n  N2 zero is found, do whatever you want to with it. End of comments explaining usage. * * * * Usage of internal variables * * * C0     Parameter = 0.\n C1     Parameter = 1.\n C1P01  Parameter = 1.01\n C1P25  Parameter = 1.25\n C2     Parameter = 2.\n C4     Parameter = 4.\n CP01   Parameter = 0.01\n CP125  Parameter = 1.25\n CP25   Parameter = 0.25\n CP5    Parameter = 0.5\n CP75   Parameter = 0.75\n CP99   Parameter = 0.99\n R1MACH Gets constants associated with floating point arithmetic.\n DFDXXX = (XXMXL/FFMFL) * (est. deriv. of f w.r.t. x at x = XX).  All\n   derivatives are base on a second degree polynonial that interpolates\n   the last three points generated.\n DFDXXX = (XXMXO/FFMFL) * (est. deriv. of f w.r.t. x at x = X0).\n DIV    If artificial subdivision of the interval is used, determines\n   the amount of the sudivision.  (-XXMXOO * DIV / (1. + DIV))\n SMESS  Prints error messages.\n DXDFFF = (FFMFL/XXMXL) * (est. deriv. of x w.r.t. f at f = FF).\n DXDFFO = (FFMFO/XXMXL) * (est. deriv. of x w.r.t. f at f = FO).\n F1     (formal arg.) The last value of F computed, on return the value\n   of F(X1).\n F2     (formal arg.) The other initial value provided for F.  Set to\n   the value of F(X2) on returns.\n FDAT   Temporary storage for floating point values for messages.\n FF     Value of F1 after F is computed.\n FFDFO  FF / FO\n FFMFB  FFMFL + FLMFB = FF - value of FF 2 iterations back.\n FFMFL  FF - FL\n FL     Value of FF from the previous iteration. FLMFB  Value of FFMFL from the previous iteration\n FO     F(XO)\n 