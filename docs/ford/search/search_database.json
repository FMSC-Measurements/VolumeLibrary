ile)\n1992-02-20 AMACH  Snyder  Added Cray-YMP stuff, q.v.\n1990-06-11 AMACH  Snyder  Added Apollo DN-10000 stuff, q.v.\n1990-12-14 AMACH  Lawson  Changed to eliminate ENTRY statements.\n1990-08-21 AMACH  Krogh   No test was getting done for bad machine.\n1990-02-28 AMACH  Krogh   Correct missing DOUBLE PRECISION AMSUB1\n1989-08-14 AMACH  Krogh   Parameterized everything -- Massive change\n1989-03-30 AMACH  Snyder  Correct missing \"/\" line 921\n1989-01-30 AMACH  Snyder  Incorporate more constants from NETLIB.\n1988-05-19 AMACH  Lawson  Initial code. integer :: I1 1992-04-07 AMACH  Oken    Removed &#94;Z at EOF (error found by VAX compile)\n1992-02-20 AMACH  Snyder  Added Cray-YMP stuff, q.v.\n1990-06-11 AMACH  Snyder  Added Apollo DN-10000 stuff, q.v.\n1990-12-14 AMACH  Lawson  Changed to eliminate ENTRY statements.\n1990-08-21 AMACH  Krogh   No test was getting done for bad machine.\n1990-02-28 AMACH  Krogh   Correct missing DOUBLE PRECISION AMSUB1\n1989-08-14 AMACH  Krogh   Parameterized everything -- Massive change\n1989-03-30 AMACH  Snyder  Correct missing \"/\" line 921\n1989-01-30 AMACH  Snyder  Incorporate more constants from NETLIB.\n1988-05-19 AMACH  Lawson  Initial code. real :: R1 double precision :: D1","tags":"","url":"proc\\amach.html"},{"title":"AMTEST – Volume Library","text":"subroutine AMTEST(TEST, D6) Arguments Type Intent Optional Attributes Name double precision :: TEST double precision :: D6","tags":"","url":"proc\\amtest.html"},{"title":"SF_2PTH1 – Volume Library","text":"function SF_2PTH1(JSP, GEOSUB, SETOPT, DBH, HTRY, DBTBH, HEX, ZEX, F, RHFW, RFLW, TAPCOE, h1, d1) SF_2PTH1\n  HTRY      IN   R*4    A trial value for total ht.\n  SF_2PTH1  OUT  R*4    Predicted dib at h1 minus measured diameter there Arguments Type Intent Optional Attributes Name integer :: JSP character(len=2) :: GEOSUB integer :: SETOPT (6) real :: DBH real :: HTRY real :: DBTBH real(kind=4) :: HEX (2) real(kind=4) :: ZEX (2) real(kind=4) :: F real(kind=4) :: RHFW (4) real(kind=4) :: RFLW (6) real(kind=4) :: TAPCOE (12) real :: h1 real :: d1 Return Value real","tags":"","url":"proc\\sf_2pth1.html"},{"title":"SF_2PTH – Volume Library","text":"subroutine SF_2PTH(JSP, GEOSUB, SETOPT, DBH, h1, d1, DBTBH, TOTALH, HEX, ZEX, F, RHFW, RFLW, TAPCOE) Arguments Type Intent Optional Attributes Name integer :: JSP character(len=2) :: GEOSUB integer :: SETOPT (6) real :: DBH real :: h1 real :: d1 real :: DBTBH real :: TOTALH real(kind=4) :: HEX (2) real(kind=4) :: ZEX (2) real(kind=4) :: F real(kind=4) :: RHFW (4) real(kind=4) :: RFLW (6) real(kind=4) :: TAPCOE (12)","tags":"","url":"proc\\sf_2pth.html"},{"title":"PROFILE – Volume Library","text":"subroutine PROFILE(REGN, FORST, VOLEQ, MTOPP, MTOPS, STUMP, DBHOB, HTTYPE, HTTOT, HTLOG, HT1PRD, HT2PRD, UPSHT1, UPSHT2, UPSD1, UPSD2, AVGZ1, AVGZ2, HTREF, DBTBH, BTR, LOGDIA, BOLHT, LOGLEN, LOGVOL, VOL, LOGST, NOLOGP, NOLOGS, CUTFLG, BFPFLG, CUPFLG, CDPFLG, SPFLG, DRCOB, CTYPE, FCLASS, PROD, ERRFLAG) Uses DEBUG_MOD --    DETERMINE TOTAL CUBIC FIBER CONTENT (ALL TREES)       * GET BOARD FOOT PRODUCT VOLUMES          * find volume for 32 foot logs ( Flewelling & Demars equation only ) * * * 32 foot logs endif * * * * CUBIC FOOT MAIN STEM EQUATIONS  ALL TREES             * --   DETERMINE IF A CUBIC FOOT PRODUCT REPRESTNTATION IS NEEDED RETURN 32 FOOT LOGS CORD WOOD MAIN STEM EQUATIONS  ALL TREES             * --   SET LOGST TO NUMBER OF SEGMENTS MAIN STEM --  DETERMINE SECONDARY PRODUCTS (TOP WOOD) ALL TREES          * GET CUBIC VOLUME FOR THE PIECES SMALIAN FORMULA     * Arguments Type Intent Optional Attributes Name integer :: REGN character(len=2) :: FORST character(len=10) :: VOLEQ real :: MTOPP real :: MTOPS real :: STUMP real :: DBHOB character(len=1) :: HTTYPE real :: HTTOT integer :: HTLOG real :: HT1PRD real :: HT2PRD real :: UPSHT1 real :: UPSHT2 real :: UPSD1 real :: UPSD2 real :: AVGZ1 real :: AVGZ2 integer :: HTREF real :: DBTBH real :: BTR real :: LOGDIA (21,3) real :: BOLHT (21) real :: LOGLEN (20) real :: LOGVOL (7,20) real :: VOL (15) integer :: LOGST real :: NOLOGP real :: NOLOGS integer :: CUTFLG integer :: BFPFLG integer :: CUPFLG integer :: CDPFLG integer :: SPFLG real :: DRCOB character(len=1) :: CTYPE integer :: FCLASS character(len=2) :: PROD integer :: ERRFLAG","tags":"","url":"proc\\profile.html"},{"title":"TCUBIC – Volume Library","text":"subroutine TCUBIC(VOLEQ, FORST, JSP, NEXTRA, SETOPT, DBHOB, HTTOT, DBTBH, MTOPP, HEX, DEX, ZEX, RHFW, RFLW, TAPCOE, F, FMOD, PINV_Z, TOP6, TCVOL, slope, errflag, VOL, MTOPS) Arguments Type Intent Optional Attributes Name character(len=10) :: VOLEQ character(len=2) :: FORST integer :: JSP integer :: NEXTRA integer :: SETOPT (6) real :: DBHOB real :: HTTOT real :: DBTBH real :: MTOPP real :: HEX (2) real :: DEX (2) real :: ZEX (2) real :: RHFW (4) real :: RFLW (6) real :: TAPCOE (12) real :: F real :: FMOD (3) real :: PINV_Z (2) real :: TOP6 real :: TCVOL real :: slope integer :: errflag real :: VOL (15) real :: MTOPS","tags":"","url":"proc\\tcubic.html"},{"title":"MERLEN – Volume Library","text":"subroutine MERLEN(VOLEQ, FORST, JSP, NEXTRA, SETOPT, DBHOB, HTTOT, DBTBH, HEX, DEX, ZEX, RHFW, RFLW, TAPCOE, F, FMOD, PINV_Z, TOP6, STUMP, TOP, LMERCH, errflag) Arguments Type Intent Optional Attributes Name character(len=10) :: VOLEQ character(len=2) :: FORST integer :: JSP integer :: NEXTRA integer :: SETOPT (6) real :: DBHOB real :: HTTOT real :: DBTBH real :: HEX (2) real :: DEX (2) real :: ZEX (2) real :: RHFW (4) real :: RFLW (6) real :: TAPCOE (12) real :: F real :: FMOD (3) real :: PINV_Z (2) real :: TOP6 real :: STUMP real :: TOP real :: LMERCH integer :: errflag","tags":"","url":"proc\\merlen.html"},{"title":"GETDIB – Volume Library","text":"subroutine GETDIB(VOLEQ, FORST, JSP, NEXTRA, SETOPT, DBHOB, HTTOT, MTOPP, STUMP, TRIM, DBTBH, LOGST, HEX, DEX, ZEX, RHFW, RFLW, TAPCOE, F, FMOD, PINV_Z, TOP6, NUMSEG, LOGLEN, LOGDIA, BOLHT, errflag) Uses DEBUG_MOD Arguments Type Intent Optional Attributes Name character(len=10) :: VOLEQ character(len=2) :: FORST integer :: JSP integer :: NEXTRA integer :: SETOPT (6) real :: DBHOB real :: HTTOT real :: MTOPP real :: STUMP real :: TRIM real :: DBTBH integer :: LOGST real :: HEX (2) real :: DEX (2) real :: ZEX (2) real :: RHFW (4) real :: RFLW (6) real :: TAPCOE (12) real :: F real :: FMOD (3) real :: PINV_Z (2) real :: TOP6 integer :: NUMSEG real :: LOGLEN (20) real :: LOGDIA (21,3) real :: BOLHT (21) integer :: errflag","tags":"","url":"proc\\getdib.html"},{"title":"TOP6LEN – Volume Library","text":"subroutine TOP6LEN(VOLEQ, HTTOT, DBHOB, DEX, HEX, STUMP, TOP, TOP6, DBTBH, errflag) Arguments Type Intent Optional Attributes Name character(len=10) :: VOLEQ real :: HTTOT real :: DBHOB real :: DEX (2) real :: HEX (2) real :: STUMP real :: TOP real :: TOP6 real :: DBTBH integer :: errflag","tags":"","url":"proc\\top6len.html"},{"title":"VOLRATIO – Volume Library","text":"subroutine VOLRATIO(VOLEQ, FORST, DBHOB, HTTOT, TOPD, LOGDIB, LOGLEN, NUMSEG, CUBV, VMER) Arguments Type Intent Optional Attributes Name character(len=10) :: VOLEQ character(len=2) :: FORST real :: DBHOB real :: HTTOT real :: TOPD real :: LOGDIB (21,3) real :: LOGLEN (20) integer :: NUMSEG real :: CUBV real :: VMER","tags":"","url":"proc\\volratio.html"},{"title":"TAPERMODEL – Volume Library","text":"subroutine TAPERMODEL(VOLEQ, FORST, JSP, NEXTRA, SETOPT, DBHOB, HTTOT, DBTBH, HEX, DEX, ZEX, RHFW, RFLW, TAPCOE, F, FMOD, PINV_Z, TOP6, HT2, MTOPP, MFLG, CUVOL, DIB, DOB, errflag) Uses VOLINPUT_MOD Arguments Type Intent Optional Attributes Name character(len=10) :: VOLEQ character(len=2) :: FORST integer :: JSP integer :: NEXTRA integer :: SETOPT (6) real :: DBHOB real :: HTTOT real :: DBTBH real :: HEX (2) real :: DEX (2) real :: ZEX (2) real :: RHFW (4) real :: RFLW (6) real :: TAPCOE (12) real :: F real :: FMOD (3) real :: PINV_Z (2) real :: TOP6 real :: HT2 real :: MTOPP integer :: MFLG real :: CUVOL real :: DIB real :: DOB integer :: errflag","tags":"","url":"proc\\tapermodel.html"},{"title":"FWSMALL – Volume Library","text":"subroutine FWSMALL(JSP, NEXTRA, SETOPT, SLOPE, DBHOB, HTTOT, DBTBH, HEX, ZEX, RHFW, RFLW, TAPCOE, F, FMOD, PINV_Z, DIB1, errflag) Arguments Type Intent Optional Attributes Name integer :: JSP integer :: NEXTRA integer :: SETOPT (6) real :: SLOPE real :: DBHOB real :: HTTOT real :: DBTBH real :: HEX (2) real :: ZEX (2) real :: RHFW (4) real :: RFLW (6) real :: TAPCOE (12) real :: F real :: FMOD (3) real :: PINV_Z (2) real :: DIB1 integer :: errflag","tags":"","url":"proc\\fwsmall.html"},{"title":"VOLINTRP – Volume Library","text":"subroutine VOLINTRP(REGN, VOLEQ, DBH, LHT, MHT, MTOPP, HTTYPE, DBTBH, LOGVOL, LOGDIA, HTLOG, LOGLEN, LOGST, NOLOGP, VOL, CTYPE, PROD, ERRFLAG) * * * 32 foot logs endif * * * * calculate stump and stem tip volume\n      IF(STUMP.LT.0.01) STUMP=1.0\n      VOL(14)=0.005454154 LOGDIA(1,2) LOGDIA(1,2)*STUMP\n      IF(VOL(4).GT.0.0) VOL(15)=VOL(1)-VOL(14)-VOL(4)-VOL(7)\n      IF(VOL(15).LT.0.01) VOL(15)=0.0 Arguments Type Intent Optional Attributes Name integer :: REGN character(len=10) :: VOLEQ real :: DBH real :: LHT real :: MHT real :: MTOPP character(len=1) :: HTTYPE real :: DBTBH real :: LOGVOL (7,20) real :: LOGDIA (21,3) integer :: HTLOG real :: LOGLEN (20) integer :: LOGST real :: NOLOGP real :: VOL (15) character(len=1) :: CTYPE character(len=2) :: PROD integer :: ERRFLAG","tags":"","url":"proc\\volintrp.html"},{"title":"R10HTS – Volume Library","text":"subroutine R10HTS(EQNUM, HTTOT, HT1PRD, DBHOB, HTTYPE, STUMP, TOP, LMERCH) TAPEQU IS THE PROFILE EQUATION NUMBER THAT WILL BE USED IN THE \n         CALCULATIONS\n         TAPEQU 1051 IS SPRUCE-HEMLOCK - 16 FOOT LOGS\n         TAPEQU 1052 IS SPRUCE-HEMLOCK - 32 FOOT LOGS\n         TAPEQU 1053 IS WESTERN REDCEDAR - 16 FOOT LOGS\n         TAPEQU 1054 IS WESTERN REDCEDAR - 32 FOOT LOGS\n         TAPEQU 1055 IS ALASKA CEDAR - 16 FOOT LOGS\n         TAPEQU 1056 IS ALASKA CEDAR - 32 FOOT LOGS\n HTTOT    IS THE TOTAL HEIGHT OF TREE FROM GROUND TO TIP\n DBHOB    IS DIAMETER BREAST HEIGHT OUTSIDE BARK\n STUMP  IS THE HEIGHT OF THE STUMP\n TOP    IS SPECIFIED TOP DIAMETER\n LMERCH IS THE MERCHANTABLE LENTH FROM STUMP TO SPECIFIED\n         TOP DIAMETER, INCLUDING TRIM. BARK THICKNESS EQUATION BARK THICKNESS EQUATION FOR WESTERN RED CEDAR BARK THICKNESS EQUATION FOR ALASKA YELLOW CEDAR BARK THICKNESS EQUATION FOR RED ALDER Arguments Type Intent Optional Attributes Name character(len=10) :: EQNUM real :: HTTOT real :: HT1PRD real :: DBHOB character(len=1) :: HTTYPE real :: STUMP real :: TOP real :: LMERCH","tags":"","url":"proc\\r10hts.html"},{"title":"FIREWOOD – Volume Library","text":"subroutine FIREWOOD(VOLEQ, FORST, JSP, NEXTRA, SETOPT, DBHOB, HTTOT, LMERCH, DBTBH, MTOPP, STUMP, HEX, DEX, ZEX, RHFW, RFLW, TAPCOE, F, FMOD, PINV_Z, TOP6, TCVOL, slope, errflag) Arguments Type Intent Optional Attributes Name character(len=10) :: VOLEQ character(len=2) :: FORST integer :: JSP integer :: NEXTRA integer :: SETOPT (6) real :: DBHOB real :: HTTOT real :: LMERCH real :: DBTBH real :: MTOPP real :: STUMP real :: HEX (2) real :: DEX (2) real :: ZEX (2) real :: RHFW (4) real :: RFLW (6) real :: TAPCOE (12) real :: F real :: FMOD (3) real :: PINV_Z (2) real :: TOP6 real :: TCVOL real :: slope integer :: errflag","tags":"","url":"proc\\firewood.html"},{"title":"FIAEQ2NVELEQ – Volume Library","text":"subroutine FIAEQ2NVELEQ(FIAEQ, SPN, GEOSUB, MTOPP, NVELEQ, VOLTYPE, ERRFLG) Arguments Type Intent Optional Attributes Name character(len=10) :: FIAEQ integer :: SPN character(len=10) :: GEOSUB real :: MTOPP character(len=10) :: NVELEQ character(len=10) :: VOLTYPE integer :: ERRFLG","tags":"","url":"proc\\fiaeq2nveleq.html"},{"title":"FIABEQ2NVELBEQ – Volume Library","text":"subroutine FIABEQ2NVELBEQ(BEQNUM, SPN, NVELBEQ, GEOSUB, ERRFLG) DONE = 19\nLAST = 1 Arguments Type Intent Optional Attributes Name integer :: BEQNUM integer :: SPN character(len=12) :: NVELBEQ character(len=12) :: GEOSUB integer :: ERRFLG","tags":"","url":"proc\\fiabeq2nvelbeq.html"},{"title":"FIA_RM – Volume Library","text":"subroutine FIA_RM(BEQ, DBHOB, HTTOT, STEMS, VOL, BMS) Arguments Type Intent Optional Attributes Name character(len=12) :: BEQ real :: DBHOB real :: HTTOT integer :: STEMS real :: VOL (15) real :: BMS","tags":"","url":"proc\\fia_rm.html"},{"title":"CHO_WDBK_1530 – Volume Library","text":"subroutine CHO_WDBK_1530(SPN, DRC, HT, CV15, STEMS, SG, BIO3) Arguments Type Intent Optional Attributes Name integer :: SPN real :: DRC real :: HT real :: CV15 integer :: STEMS real :: SG real :: BIO3","tags":"","url":"proc\\cho_wdbk_1530.html"},{"title":"WOODLAND_BIO – Volume Library","text":"subroutine WOODLAND_BIO(SPCD, DRC, THT, STEMS, CV15, DRYBIO, ERRFLG) Arguments Type Intent Optional Attributes Name integer :: SPCD real :: DRC real :: THT integer :: STEMS real :: CV15 real :: DRYBIO (15) integer :: ERRFLG","tags":"","url":"proc\\woodland_bio.html"},{"title":"GREGORY_VOL – Volume Library","text":"subroutine GREGORY_VOL(VOLEQ, DBHOB, HTTOT, MTOPP, BFMIND, VOL, ERRFLG) Arguments Type Intent Optional Attributes Name character(len=10) :: VOLEQ real :: DBHOB real :: HTTOT real :: MTOPP real :: BFMIND real :: VOL (15) integer :: ERRFLG","tags":"","url":"proc\\gregory_vol.html"},{"title":"GREGORY_CV6 – Volume Library","text":"subroutine GREGORY_CV6(SPN, DBH, THT, CV6) Arguments Type Intent Optional Attributes Name integer :: SPN real :: DBH real :: THT real :: CV6","tags":"","url":"proc\\gregory_cv6.html"},{"title":"EMBRY_VOL – Volume Library","text":"subroutine EMBRY_VOL(VOLEQ, DBHOB, HTTOT, MTOPP, BFMIND, VOL, ERRFLG) Arguments Type Intent Optional Attributes Name character(len=10) :: VOLEQ real :: DBHOB real :: HTTOT real :: MTOPP real :: BFMIND real :: VOL (15) integer :: ERRFLG","tags":"","url":"proc\\embry_vol.html"},{"title":"CONE_CV – Volume Library","text":"subroutine CONE_CV(DBH, THT, TOP, CV) Arguments Type Intent Optional Attributes Name real :: DBH real :: THT real :: TOP real :: CV","tags":"","url":"proc\\cone_cv.html"},{"title":"DEMARS_VOL – Volume Library","text":"subroutine DEMARS_VOL(VOLEQ, DBHOB, HTTOT, MTOPP, STUMP, BFMIND, VOL, ERRFLG) Arguments Type Intent Optional Attributes Name character(len=10) :: VOLEQ real :: DBHOB real :: HTTOT real :: MTOPP real :: STUMP real :: BFMIND real :: VOL (15) integer :: ERRFLG","tags":"","url":"proc\\demars_vol.html"},{"title":"DEMARS_EMBRY – Volume Library","text":"subroutine DEMARS_EMBRY(VOLEQ, DBHOB, HTTOT, MTOPP, STUMP, BFMIND, VOL, ERRFLG) Arguments Type Intent Optional Attributes Name character(len=10) :: VOLEQ real :: DBHOB real :: HTTOT real :: MTOPP real :: STUMP real :: BFMIND real :: VOL (15) integer :: ERRFLG","tags":"","url":"proc\\demars_embry.html"},{"title":"BROWNE_DEMARS_EMBRY – Volume Library","text":"subroutine BROWNE_DEMARS_EMBRY(VOLEQ, DBHOB, HTTOT, MTOPP, STUMP, BFMIND, VOL, ERRFLG) Arguments Type Intent Optional Attributes Name character(len=10) :: VOLEQ real :: DBHOB real :: HTTOT real :: MTOPP real :: STUMP real :: BFMIND real :: VOL (15) integer :: ERRFLG","tags":"","url":"proc\\browne_demars_embry.html"},{"title":"RELATIVE_DIA – Volume Library","text":"subroutine RELATIVE_DIA(SPN, DBH, HT, RELHT, GEOSUB, RELD) Arguments Type Intent Optional Attributes Name integer :: SPN real :: DBH real :: HT real :: RELHT character(len=1) :: GEOSUB real :: RELD","tags":"","url":"proc\\relative_dia.html"},{"title":"VOLUME_RATIO – Volume Library","text":"subroutine VOLUME_RATIO(SPN, DBH, HT, RELHT, GEOSUB, VR) Arguments Type Intent Optional Attributes Name integer :: SPN real :: DBH real :: HT real :: RELHT character(len=1) :: GEOSUB real :: VR","tags":"","url":"proc\\volume_ratio.html"},{"title":"BRSQ_DEMARS – Volume Library","text":"subroutine BRSQ_DEMARS(SPN, DBH, HT, GEOSUB, BRSQ) Arguments Type Intent Optional Attributes Name integer :: SPN real :: DBH real :: HT character(len=1) :: GEOSUB real :: BRSQ","tags":"","url":"proc\\brsq_demars.html"},{"title":"MERCH_HT – Volume Library","text":"subroutine MERCH_HT(SPN, DBH, HT, TOP, BRSQ, GEOSUB, MHT) Arguments Type Intent Optional Attributes Name integer :: SPN real :: DBH real :: HT real :: TOP real :: BRSQ character(len=1) :: GEOSUB real :: MHT","tags":"","url":"proc\\merch_ht.html"},{"title":"R12VOL – Volume Library","text":"subroutine R12VOL(eqnum, MTOPP, HT1PRD, DBHOB, HTTOT, VOL, NOLOGP, NOLOGS, FCLASS, CUTFLG, BFPFLG, CUPFLG, ERRFLAG) --    DETERMINE TOTAL CUBIC FIBER CONTENT (ALL TREES)       * --   SUBROUTINE \"R12TAP\" IS THE PROFILE MODEL BOARD FOOT CACULATIONS  (DBHOB GE 10.0)              * CUBIC FOOT MAIN STEM EQUATIONS  ALL TREES             * CORD WOOD MAIN STEM EQUATIONS  ALL TREES             * --  DETERMINE TOP WOOD CUBIC FOOT PRODUCTS (ALL TREES)\n--    ONLY ONE STEM PROFILE EQUATION MAY BE SPECIFIED FOR BDFT,\n--    CUFT, AND CORDS AND ONLY ONE TOP DIAMETER MAY BE SPECIFIED\n--    BEFORE TOP WOOD VOLUME CAN BE DETERMINED. Arguments Type Intent Optional Attributes Name character(len=10) :: eqnum real :: MTOPP real :: HT1PRD real :: DBHOB real :: HTTOT real :: VOL (15) real :: NOLOGP real :: NOLOGS integer :: FCLASS integer :: CUTFLG integer :: BFPFLG integer :: CUPFLG integer :: ERRFLAG","tags":"","url":"proc\\r12vol.html"},{"title":"PROFILE2 – Volume Library","text":"subroutine PROFILE2(REGN, FORST, VOLEQ, MTOPP, MTOPS, STUMP, DBHOB, HTTYPE, HTTOT, HTLOG, HT1PRD, HT2PRD, UPSHT1, UPSHT2, UPSD1, UPSD2, AVGZ1, AVGZ2, HTREF, DBTBH, BTR, LOGDIA, BOLHT, LOGLEN, LOGVOL, VOL, LOGST, NOLOGP, NOLOGS, CUTFLG, BFPFLG, CUPFLG, CDPFLG, SPFLG, DRCOB, CTYPE, FCLASS, PROD, ERRFLAG, MERRULES) Uses VOLINPUT_MOD MRULES_MOD DEBUG_MOD --    DETERMINE TOTAL CUBIC FIBER CONTENT (ALL TREES)       * GET BOARD FOOT PRODUCT VOLUMES          * find volume for 32 foot logs ( Flewelling & Demars equation only ) * * * 32 foot logs endif * * * * CUBIC FOOT MAIN STEM EQUATIONS  ALL TREES             * --   DETERMINE IF A CUBIC FOOT PRODUCT REPRESTNTATION IS NEEDED RETURN 32 FOOT LOGS CORD WOOD MAIN STEM EQUATIONS  ALL TREES             * --   SET LOGST TO NUMBER OF SEGMENTS MAIN STEM --  DETERMINE SECONDARY PRODUCTS (TOP WOOD) ALL TREES          * GET CUBIC VOLUME FOR THE PIECES SMALIAN FORMULA     * Arguments Type Intent Optional Attributes Name integer :: REGN character(len=2) :: FORST character(len=10) :: VOLEQ real :: MTOPP real :: MTOPS real :: STUMP real :: DBHOB character(len=1) :: HTTYPE real :: HTTOT integer :: HTLOG real :: HT1PRD real :: HT2PRD real :: UPSHT1 real :: UPSHT2 real :: UPSD1 real :: UPSD2 real :: AVGZ1 real :: AVGZ2 integer :: HTREF real :: DBTBH real :: BTR real :: LOGDIA (21,3) real :: BOLHT (21) real :: LOGLEN (20) real :: LOGVOL (7,20) real :: VOL (15) integer :: LOGST real :: NOLOGP real :: NOLOGS integer :: CUTFLG integer :: BFPFLG integer :: CUPFLG integer :: CDPFLG integer :: SPFLG real :: DRCOB character(len=1) :: CTYPE integer :: FCLASS character(len=2) :: PROD integer :: ERRFLAG type( MERCHRULES ) :: MERRULES","tags":"","url":"proc\\profile2.html"},{"title":"r6fix – Volume Library","text":"subroutine r6fix(DBHOB, FCLASS, tlh, tth, httype, logvol) Arguments Type Intent Optional Attributes Name real :: DBHOB integer :: FCLASS real :: tlh real :: tth character(len=1) :: httype real :: logvol (7,20)","tags":"","url":"proc\\r6fix.html"},{"title":"R6DIBS – Volume Library","text":"subroutine R6DIBS(IAPZ, DBHOB, IBTR, FCLASS, MTOPP, TLH, TH, XLOGS, LOGDIA, SL, XL, A) * * * EASTSIDE * * * * * * * * WESTSIDE * * *** Arguments Type Intent Optional Attributes Name integer :: IAPZ real :: DBHOB real :: IBTR integer :: FCLASS real :: MTOPP real :: TLH real :: TH real :: XLOGS real :: LOGDIA (21,3) real :: SL (20) real :: XL (20) real :: A","tags":"","url":"proc\\r6dibs.html"},{"title":"BRK_UP – Volume Library","text":"subroutine BRK_UP(JSP, geosub, DBHOB, THT, DBTBH, HTUP, DIB, DOB, DBT) Arguments Type Intent Optional Attributes Name integer :: JSP character(len=2) :: geosub real :: DBHOB real :: THT real :: DBTBH real :: HTUP real :: DIB real :: DOB real :: DBT","tags":"","url":"proc\\brk_up.html"},{"title":"FIA_SE – Volume Library","text":"subroutine FIA_SE(BEQ, DBHOB, HTTOT, VOL, BMS) Arguments Type Intent Optional Attributes Name character(len=12) :: BEQ real :: DBHOB real :: HTTOT real :: VOL (15) real :: BMS","tags":"","url":"proc\\fia_se.html"},{"title":"R10TAP – Volume Library","text":"subroutine R10TAP(TAPEQU, DBHOB, HTTOT, HTUP, D2) WESTERN REDCEDAR\n\n THIS EQUATION IS USED WHEN CALCULATING DIB'S ALONG THE TREE STEM\n THIS EQUATION NUMBER 1053 AND 1054 ALASKA YELLOW CEDAR\n\n THIS EQUATION IS USED WHEN CALCULATING DIB'S ALONG THE TREE STEM\n THIS EQUATION NUMBER 1055 AND 1056 Arguments Type Intent Optional Attributes Name character(len=10) :: TAPEQU real :: DBHOB real :: HTTOT real :: HTUP real :: D2","tags":"","url":"proc\\r10tap.html"},{"title":"R4VOL – Volume Library","text":"subroutine R4VOL(REGN, VOLEQ, MTOPP, HTTOT, DBHOB, HT1PRD, VOL, NOLOGP, NOLOGS, LOGDIA, LOGLEN, LOGVOL, BOLHT, CUTFLG, BFPFLG, CUPFLG, CDPFLG, SPFLG, ERRFLAG) DETERMINE INDEX 'II' FOR HT67, STUMPD, AND DIB67\n  BASED ON TAPER EQUATION NUMBER (VOLEQ)\n comment out 03/21/2017 YW\n      IF(VOLEQ(8:10).EQ.'746') THEN\n        II=1\n      ELSEIF(VOLEQ(8:10).EQ.'202'.AND.VOLEQ(1:3).EQ.'400') THEN\n        II=2\n      ELSEIF(VOLEQ(8:10).EQ.'202'.AND.VOLEQ(1:3).EQ.'405') THEN\n        II=3\n      ELSEIF(VOLEQ(8:10).EQ.'202'.AND.VOLEQ(1:3).EQ.'401') THEN\n        II=4\n      ELSEIF(VOLEQ(8:10).EQ.'019'.AND.VOLEQ(1:3).EQ.'400') THEN\n        II=5\n      ELSEIF(VOLEQ(8:10).EQ.'019'.AND.VOLEQ(1:3).EQ.'405') THEN\n        II=6\n      ELSEIF(VOLEQ(8:10).EQ.'015'.AND.VOLEQ(1:3).EQ.'400') THEN\n        II=7\n      ELSEIF(VOLEQ(8:10).EQ.'015'.AND.VOLEQ(1:3).EQ.'401') THEN\n        II=8\n      ELSEIF(VOLEQ(8:10).EQ.'081') THEN\n        II=9\n      ELSEIF(VOLEQ(8:10).EQ.'073') THEN\n        II=10\n      ELSEIF(VOLEQ(8:10).EQ.'122'.AND.VOLEQ(1:3).EQ.'403') THEN\n        II=11\n      ELSEIF(VOLEQ(8:10).EQ.'108'.AND.VOLEQ(1:3).EQ.'400') THEN\n        II=12\n      ELSEIF(VOLEQ(8:10).EQ.'108'.AND.VOLEQ(1:3).EQ.'401') THEN\n        II=13\n      ELSEIF(VOLEQ(8:10).EQ.'122'.AND.VOLEQ(1:3).EQ.'401') THEN\n        II=14\n      ELSEIF(VOLEQ(8:10).EQ.'122'.AND.VOLEQ(1:3).EQ.'402') THEN\n        II=15\n      ELSEIF(VOLEQ(8:10).EQ.'122'.AND.VOLEQ(1:3).EQ.'400') THEN\n        II=16\n      ELSEIF(VOLEQ(8:10).EQ.'093'.AND.VOLEQ(1:3).EQ.'400') THEN\n        II=17\n      ELSEIF(VOLEQ(8:10).EQ.'093'.AND.VOLEQ(1:3).EQ.'407') THEN\n        II=18\n      ELSEIF(VOLEQ(8:10).EQ.'020') THEN\n        II=19\n      ELSEIF(VOLEQ(8:10).EQ.'117') THEN\n        II=20\n      ELSE\n        ERRFLAG = 1\n        RETURN\n      ENDIF sutract one foot from height for mathis equations LOOP TO COMPUTE GROSS VOLS\n  !LIMIT BF TOP DIAMETER TO 6 INCHES MINIMUM\n  M=1 FOR BF; M=2 FOR CORDWOOD; M=3 FOR CF\n  NUM = LOG NUMBER - UP TO 20 PER TREE CONVERT & STORE VOLUMES IN DESCRIPTIVE VARIABLES Arguments Type Intent Optional Attributes Name integer :: REGN character(len=10) :: VOLEQ real :: MTOPP real :: HTTOT real :: DBHOB real :: HT1PRD real :: VOL (15) real :: NOLOGP real :: NOLOGS real :: LOGDIA (21,3) real :: LOGLEN (20) real :: LOGVOL (7,20) real :: BOLHT (21) integer :: CUTFLG integer :: BFPFLG integer :: CUPFLG integer :: CDPFLG integer :: SPFLG integer :: ERRFLAG","tags":"","url":"proc\\r4vol.html"},{"title":"R4MATTAPER – Volume Library","text":"subroutine R4MATTAPER(VOLEQ, DBHOB, HTTOT, STUMPD, BUTTCF, CF0, B, HTUP, DIB, ERRFLAG) DETERMINE INDEX 'II' FOR HT67, STUMPD, AND DIB67\n  BASED ON TAPER EQUATION NUMBER (VOLEQ) Arguments Type Intent Optional Attributes Name character(len=10) :: VOLEQ real :: DBHOB real :: HTTOT real :: STUMPD real :: BUTTCF real :: CF0 real :: B real :: HTUP real :: DIB integer :: ERRFLAG","tags":"","url":"proc\\r4mattaper.html"},{"title":"CLARK_VOL – Volume Library","text":"subroutine CLARK_VOL(VOLEQ, DBHOB, HTTOT, BFMIND, VOL, ERRFLG, CROWN) Arguments Type Intent Optional Attributes Name character(len=10) :: VOLEQ real :: DBHOB 