kind=4) :: TAPCOE (12) real(kind=4) :: F real :: PINV_Z (2) real :: FMOD (3)","tags":"","url":"proc\\sf_3pt.html"},{"title":"SRS_VOL – Volume Library","text":"subroutine SRS_VOL(VOLEQ, DBHOB, HTTOT, BFMIND, VOL, ERRFLG) Arguments Type Intent Optional Attributes Name character(len=10) :: VOLEQ real :: DBHOB real :: HTTOT real :: BFMIND real :: VOL (15) integer :: ERRFLG","tags":"","url":"proc\\srs_vol.html"},{"title":"BERG_VOL – Volume Library","text":"subroutine BERG_VOL(VOLEQ, DBHOB, HTTOT, VOL, ERRFLG) Arguments Type Intent Optional Attributes Name character(len=10) :: VOLEQ real :: DBHOB real :: HTTOT real :: VOL (15) integer :: ERRFLG","tags":"","url":"proc\\berg_vol.html"},{"title":"FAUROT_VOL – Volume Library","text":"subroutine FAUROT_VOL(VOLEQ, DBHOB, HTTOT, BFMIND, MTOPP, VOL, ERRFLG) Arguments Type Intent Optional Attributes Name character(len=10) :: VOLEQ real :: DBHOB real :: HTTOT real :: BFMIND real :: MTOPP real :: VOL (15) integer :: ERRFLG","tags":"","url":"proc\\faurot_vol.html"},{"title":"MOISEN_VOL – Volume Library","text":"subroutine MOISEN_VOL(VOLEQ, DBHOB, HTTOT, MTOPP, BFMIND, VOL, ERRFLG) Arguments Type Intent Optional Attributes Name character(len=10) :: VOLEQ real :: DBHOB real :: HTTOT real :: MTOPP real :: BFMIND real :: VOL (15) integer :: ERRFLG","tags":"","url":"proc\\moisen_vol.html"},{"title":"ALLEN_SMALLTREE – Volume Library","text":"subroutine ALLEN_SMALLTREE(VOLEQ, DBHOB, HTTOT, VOL, ERRFLG) Arguments Type Intent Optional Attributes Name character(len=10) :: VOLEQ real :: DBHOB real :: HTTOT real :: VOL (15) integer :: ERRFLG","tags":"","url":"proc\\allen_smalltree.html"},{"title":"JENKINS – Volume Library","text":"subroutine JENKINS(SPEC, DBHOB, BIOMS) Arguments Type Intent Optional Attributes Name integer :: SPEC real :: DBHOB real :: BIOMS (8)","tags":"","url":"proc\\jenkins.html"},{"title":"R6VOL3 – Volume Library","text":"subroutine R6VOL3(DBHOB, DBTBH, FCLASS, HTTOT, ZONE, VOL) Arguments Type Intent Optional Attributes Name real :: DBHOB real :: DBTBH integer :: FCLASS real :: HTTOT integer :: ZONE real :: VOL (15)","tags":"","url":"proc\\r6vol3.html"},{"title":"COR_OT – Volume Library","text":"function COR_OT(JSP, HTTOT, HI, HJ) given 2 heights (hi and hj), estimate the correlation of the\n   Z errors in the corresponding dib's\n           NW Taper coop #2, (INGY, east-side 1995-1996) Arguments Type Intent Optional Attributes Name integer :: JSP real :: HTTOT real :: HI real :: HJ Return Value real","tags":"","url":"proc\\cor_ot.html"},{"title":"COR_BH – Volume Library","text":"function COR_BH(HTTOT, H30, HT2) given 2 heights (hi and hj), estimate the correlation of the\n   errors in the corresponding dib's\n    Correlations from prelim model by JWF & RLE Arguments Type Intent Optional Attributes Name real :: HTTOT real :: H30 real :: HT2 Return Value real","tags":"","url":"proc\\cor_bh.html"},{"title":"BRK_OT – Volume Library","text":"subroutine BRK_OT(JSP, geosub, DBHOB, DOB, HT2, DBTBH, DIB, dbt) Calculates double bark thickness for PP on the BHNF , PP on the SJNF , ES on the DNF Variables passed : DBHOB real in diameter breash HTTOT THT real in height of measurement point DOB real in diameter at measurement point DIB real out calculated diameter inside bark DBTBH real bark thickness ratio ( optional input ) IF ( HT2 . LT . ( THT - 2 . 0 )) THEN HTTOT = THT use wensels bark model Arguments Type Intent Optional Attributes Name integer :: JSP character(len=2) :: geosub real :: DBHOB real :: DOB real :: HT2 real :: DBTBH real :: DIB real :: dbt","tags":"","url":"proc\\brk_ot.html"},{"title":"SHP_OT – Volume Library","text":"subroutine SHP_OT(JSP, DBHOB, HTTOT, RFLW, RHFW) Arguments Type Intent Optional Attributes Name integer :: JSP real(kind=4) :: DBHOB real(kind=4) :: HTTOT real(kind=4) :: RFLW (6) real(kind=4) :: RHFW (4)","tags":"","url":"proc\\shp_ot.html"},{"title":"VAR_OT – Volume Library","text":"subroutine VAR_OT(JSP, DBHOB, HTTOT, H, SE_LNX) Variance of dib  for species assuming lognormal errors.\n            NW Coop #2, INGY\n\n                     J. W. Flewelling, July, 1996\n\n  H      input   R*4   Section height  , for h NE breast height.\n  SE_LNX output  R*4   SQRT{ VAR[ln(dib)]} Arguments Type Intent Optional Attributes Name integer :: JSP real :: DBHOB real :: HTTOT real :: H real(kind=4) :: SE_LNX","tags":"","url":"proc\\var_ot.html"},{"title":"SHP_BH – Volume Library","text":"subroutine SHP_BH(DBHOB, HTTOT, RFLW, RHFW) SF  SHAPE SUBROUTINE   BHNF Ponderosa Pine, English Units\n          coefficients from BHNF model effort JWF & RLE Arguments Type Intent Optional Attributes Name real :: DBHOB real :: HTTOT real(kind=4) :: RFLW (6) real(kind=4) :: RHFW (4)","tags":"","url":"proc\\shp_bh.html"},{"title":"VAR_BH – Volume Library","text":"subroutine VAR_BH(DBHOB, HTTOT, HUP, SE) calculates standard error for 2-point stem-form system\n   H     input    r*8    section height (ft or meters )\n   SE    output   r*8    standard error\n\n     Note: this follows Flewelling and Raynes (Part I), except:\n           special interpolation in 3 segments:\n              1.  3.0 ft to 4.5 ft  (linear on SE)\n              2.  4.5 ft to BH + 0.1*(Total height - BH) (linear on SE)\n              3.  BH + 0.9*(HTTOT - BH) to Totalht  (quadradic on SE) Arguments Type Intent Optional Attributes Name real :: DBHOB real :: HTTOT real :: HUP real(kind=4) :: SE","tags":"","url":"proc\\var_bh.html"},{"title":"R12TAP – Volume Library","text":"subroutine R12TAP(TAPEQ, DBHOB, HT1, HT2, TDIB, FCLASS, VTYPE, SVOL) CUBIC FOOT\n     KOA Arguments Type Intent Optional Attributes Name character(len=10) :: TAPEQ real :: DBHOB real :: HT1 real :: HT2 real :: TDIB integer :: FCLASS COFFICIENTS FOR SHARPNECK MODEL(B0,B1,B2,B3,B4,B5,B6)     ** BOARD FOOT\n     KOA integer :: VTYPE COFFICIENTS FOR SHARPNECK MODEL(B0,B1,B2,B3,B4,B5,B6)     ** BOARD FOOT\n     KOA real :: SVOL","tags":"","url":"proc\\r12tap.html"},{"title":"INTL78 – Volume Library","text":"subroutine 