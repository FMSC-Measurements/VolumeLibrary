{
    "name": "VolumeLibrary Dev Container",
    "build": {
        "dockerfile": "../Dockerfile",
        "context": "..",
        "target": "dev"
    },
    "remoteUser": "nvel-dev",
    "updateRemoteUserUID": true,
    "remoteEnv": {
        "PYTHONPATH": "${containerWorkspaceFolder}",
        "PATH": "${containerWorkspaceFolder}/.venv/bin:/home/nvel-dev/.local/bin:${containerEnv:PATH}"
    },
    "features": {
        "ghcr.io/devcontainers/features/github-cli:1": {},
        "ghcr.io/devcontainers/features/common-utils": {
            // "username": "nvel-dev",
            "installNano": true,
            "installZsh": true,
            "configureZshAsDefaultShell": true
        }
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "anthropic.claude-code",
                "charliermarsh.ruff",
                "github.vscode-github-actions",
                "github.vscode-pull-request-github",
                "johnpapa.vscode-peacock",
                "ms-azuretools.vscode-docker",
                "ms-python.mypy-type-checker",
                "ms-python.python",
                "ms-toolsai.jupyter",
                "vscode-icons-team.vscode-icons"
            ]
        }
    },
    "mounts": [
        "source=${localEnv:HOME}/.claude,target=/home/nvel-dev/.claude,type=bind",
        "source=${localEnv:HOME}/.claude.json,target=/home/nvel-dev/.claude.json,type=bind"
    ],
    "postCreateCommand": "uv sync --frozen --extra dev && chmod +x fortran_build/build_gfortran_shared.sh fortran_build/build_gfortran_warnings.sh fortran_build/check_warnings.sh && fortran_build/build_gfortran_shared.sh && uv run pre-commit install && curl -fsSL https://claude.ai/install.sh | bash"
}
